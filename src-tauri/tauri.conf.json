{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "beyond-wrapped",
  "version": "0.1.0",
  "identifier": "com.kavish.beyond-wrapped",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://[::1]:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Beyond Wrapped",
        "width": 480,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
